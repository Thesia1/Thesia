# Thesia runtime mode.
# Allowed: OFF, WATCH, ASSISTED, AUTONOMOUS_PAPER, AUTONOMOUS_LIVE
THESIA_MODE=WATCH

# Extra live-trading guard. AUTONOMOUS_LIVE must also set EXECUTION_ENVIRONMENT=live.
THESIA_ENABLE_LIVE=false

# Risk defaults.
THESIA_RISK_PERCENT=0.0025
THESIA_MAX_DAILY_LOSS_PERCENT=0.02
THESIA_MAX_WEEKLY_LOSS_PERCENT=0.05

# Market data selection.
# Allowed: oanda, forex_com, mt5
# Use mt5 for Deriv synthetic indices such as Volatility/Step indices.
MARKET_DATA_PROVIDER=oanda

# Market data environment.
# Allowed: practice, live
MARKET_DATA_ENVIRONMENT=practice

# Legacy aliases kept for compatibility. Prefer MARKET_DATA_* and EXECUTION_*.
BROKER_PROVIDER=oanda
BROKER_ENVIRONMENT=practice

# OANDA market-data credentials.
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_TOKEN=your_oanda_api_token_here

# Optional certificate bundle override for local Python SSL issues.
# Usually not needed because the OANDA client tries certifi automatically.
THESIA_CA_BUNDLE=

# FOREX.com broker credentials.
# REST API access may require account enablement from FOREX.com.
FOREX_COM_USERNAME=your_forex_com_username_here
FOREX_COM_PASSWORD=your_forex_com_password_here
FOREX_COM_APP_KEY=your_forex_com_app_key_here

# Execution selection.
# For our current architecture: OANDA provides market data and Deriv MT5 is the future execution path.
# Allowed: none, mt5, oanda
EXECUTION_PROVIDER=mt5

# Execution environment.
# Allowed: practice, live
EXECUTION_ENVIRONMENT=practice

# Live order placement switch and duplicate-order ledger.
# Keep false until OANDA scan, risk approval, Deriv MT5 reconciliation, and dry-run execution checks pass.
EXECUTION_ENABLE_ORDER_PLACEMENT=false
EXECUTION_IDEMPOTENCY_LEDGER_PATH=data/order-ledger.jsonl
MT5_DEVIATION_POINTS=20
MT5_MAGIC=260604

# Deriv MT5 execution credentials.
# These are not OANDA credentials and cannot be used with the OANDA REST API.
# They are also used for MT5 market data when MARKET_DATA_PROVIDER=mt5.
MT5_LOGIN=your_deriv_mt5_login_here
MT5_PASSWORD=your_deriv_mt5_password_here
MT5_SERVER=your_deriv_mt5_server_here
MT5_PATH=
MT5_TIMEOUT_MS=60000

# Optional future broker integrations.
IBKR_ACCOUNT_ID=your_ibkr_account_id_here
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Economic calendar / news blackout providers.
NEWS_PRIMARY_PROVIDER=trading_economics
NEWS_FALLBACK_PROVIDER=alpha_vantage
TRADING_ECONOMICS_API_KEY=your_trading_economics_api_key_here
ECONODAY_API_KEY=your_econoday_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Deterministic scheduled-event blackout gate.
# The file should be a JSON list with title, currency, impact, and starts_at fields.
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_EVENTS_FILE=
NEWS_BLACKOUT_BEFORE_MINUTES=60
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_BLACKOUT_MIN_IMPACT=high

# Agent / LLM provider credentials.
AGENT_PRIMARY_PROVIDER=anthropic
AGENT_FALLBACK_PROVIDER=openrouter
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Notifications and alerting.
# Used when autotrade is run with --notify-setups.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_email_username_here
EMAIL_SMTP_PASSWORD=your_email_password_here
ALERT_EMAIL_TO=alerts@example.com

# Persistence.
DATABASE_URL=sqlite:///thesia.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thesia
POSTGRES_USER=thesia
POSTGRES_PASSWORD=your_postgres_password_here

# Optional future durable event bus.
NATS_URL=nats://localhost:4222
REDPANDA_BROKERS=localhost:9092
