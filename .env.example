# Thesia runtime mode.
# Allowed: OFF, WATCH, ASSISTED, AUTONOMOUS_PAPER, AUTONOMOUS_LIVE
THESIA_MODE=WATCH

# Extra live-trading guard. AUTONOMOUS_LIVE must also set BROKER_ENVIRONMENT=live.
THESIA_ENABLE_LIVE=false

# Risk defaults.
THESIA_RISK_PERCENT=0.0025
THESIA_MAX_DAILY_LOSS_PERCENT=0.02
THESIA_MAX_WEEKLY_LOSS_PERCENT=0.05

# Broker selection.
# Allowed: oanda, forex_com
BROKER_PROVIDER=oanda

# Broker environment.
# Allowed: practice, live
BROKER_ENVIRONMENT=practice

# OANDA broker credentials.
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_TOKEN=2

# FOREX.com broker credentials.
# REST API access may require account enablement from FOREX.com.
FOREX_COM_USERNAME=your_forex_com_username_here
FOREX_COM_PASSWORD=your_forex_com_password_here
FOREX_COM_APP_KEY=your_forex_com_app_key_here

# Optional future broker integrations.
MT5_LOGIN=your_metatrader5_login_here
MT5_PASSWORD=your_metatrader5_password_here
MT5_SERVER=your_metatrader5_server_here
IBKR_ACCOUNT_ID=your_ibkr_account_id_here
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Economic calendar / news blackout providers.
TRADING_ECONOMICS_API_KEY=your_trading_economics_api_key_here
ECONODAY_API_KEY=your_econoday_api_key_here

# Agent / LLM provider credentials.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Notifications and alerting.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your_email_username_here
EMAIL_SMTP_PASSWORD=your_email_password_here
ALERT_EMAIL_TO=alerts@example.com

# Persistence.
DATABASE_URL=sqlite:///thesia.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thesia
POSTGRES_USER=thesia
POSTGRES_PASSWORD=your_postgres_password_here

# Optional future durable event bus.
NATS_URL=nats://localhost:4222
REDPANDA_BROKERS=localhost:9092
